<Page
    x:Class="FortniteLauncher.Pages.ShopItemDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FortniteLauncher.Pages"
    Background="Transparent">

    <Grid Margin="58,18,58,18" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTipService.ToolTip="Back to the shop">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="BackKeyboardAccelerator_Invoked"/>
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72B;"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid Width="126" Height="40" VerticalAlignment="Center" Margin="4,0">
                        <Image Source="{Binding RarityBadgeImageUrl}"
                               Width="{Binding DetailRarityBadgeWidth}"
                               Height="{Binding DetailRarityBadgeHeight}"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Visibility="{Binding RarityBadgeImageVisibility}"/>
                        <Border Background="{Binding RarityBadgeBackgroundBrush}"
                                BorderBrush="{Binding RarityBrush}"
                                BorderThickness="3"
                                Padding="14,5"
                                Visibility="{Binding RarityBadgeFallbackVisibility}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-12"/>
                            </Border.RenderTransform>
                            <TextBlock Text="{Binding RarityLabel}" FontSize="12" FontWeight="Bold" FontStyle="Italic" Foreground="{Binding RarityBrush}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
                <TextBlock Text="{Binding ReadableType}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="HeroImage"
                           Source="{Binding IconUrl}"
                           Stretch="Uniform"
                           MaxWidth="720"
                           MaxHeight="620"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="40"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                        <ItemsRepeater ItemsSource="{Binding ImageChoices}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="ImageThumbnail_Click"
                                            Tag="{Binding Url}"
                                            Width="66"
                                            Height="72"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="Show image">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                        </Button.Resources>
                                        <Border Background="#25293B" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Image Source="{Binding Url}" Stretch="Uniform" Margin="5,4,5,18"/>
                                                <Border Background="#D9212121" CornerRadius="0,0,5,5" VerticalAlignment="Bottom" Padding="4,2">
                                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Item Details" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Description"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="14"
                                       LineHeight="20"/>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Price" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Image Source="{Binding PriceIconUrl}" Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Price}" FontSize="20" FontWeight="SemiBold" Foreground="#36D1C4" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="14" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Rarity" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Rarity}"/>
                            <TextBlock Grid.Row="1" Text="Type" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReadableType}"/>
                            <TextBlock Grid.Row="2" Text="Slug" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Slug}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="Set" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Set}"/>
                            <TextBlock Grid.Row="4" Text="Introduced In" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntroducedIn}"/>
                            <TextBlock Grid.Row="5" Text="Release Date" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReleaseDate}"/>
                            <TextBlock Grid.Row="6" Text="Last Seen" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastSeen}"/>
                            <TextBlock Grid.Row="7" Text="Shop Occurrences" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ShopOccurrences}"/>
                            <TextBlock Grid.Row="8" Text="CID" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Cid}"/>
                            <TextBlock Grid.Row="9" Text="Bundle" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Bundle}"/>
                            <TextBlock Grid.Row="10" Text="LEGO Style" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding LegoStyle}"/>
                            <TextBlock Grid.Row="11" Text="Images Count" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ImageChoices.Count}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
